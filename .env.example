# API (all optional)
GEMINI_API_KEY=            # enables POST /v1/edit ("Edit with Nano Banana")
PEEL_EDIT_MODEL=           # force a Gemini image model id; otherwise picked from the live model list
PEEL_CORS_ORIGINS=         # extra allowed origins, comma separated
PEEL_THREADS=              # torch/OpenCV threads; set to the CPU quota inside containers
PEEL_MODEL_DIR=            # where YuNet/SFace weights are stored (default ~/.cache/peel)

# Web (build time)
VITE_API_BASE=             # API URL; empty means same origin (the API serves the build itself)
